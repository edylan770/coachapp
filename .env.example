# Copy to .env and adjust. Never commit .env.

# --- Postgres (consumed by the docker compose `db` service) ---
POSTGRES_USER=traineros
POSTGRES_PASSWORD=traineros
POSTGRES_DB=traineros

# --- API ---
# Host is localhost for local dev; docker compose overrides the host to `db`.
DATABASE_URL=postgresql+psycopg://traineros:traineros@localhost:5432/traineros
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed browser origins (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
